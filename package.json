        "builtin-modules": "3.3.0",
        "esbuild": "0.17.3",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "obsidian": "1.12.3",
        "tslib": "2.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0"
    },
    "dependencies": {
        "@foliojs-fork/pdfkit": "^0.15.3",
