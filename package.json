{
    "name": "print-ready-pdf",
    "version": "0.2.0",
    "description": "Print-optimized or format-preserving PDF export for Obsidian, built on pdfmake",
    "main": "main.js",
    "scripts": {
        "test": "tsc -noEmit -skipLibCheck",
        "dev": "node esbuild.config.mjs",
